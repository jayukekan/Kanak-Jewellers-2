{% comment %}theme-check-disable UndefinedObject{% endcomment %}
{{ 'section-footer.css' | asset_url | stylesheet_tag }}
{{ 'component-newsletter.css' | asset_url | stylesheet_tag }}
{{ 'component-list-menu.css' | asset_url | stylesheet_tag }}
{{ 'component-list-payment.css' | asset_url | stylesheet_tag }}
{{ 'component-list-social.css' | asset_url | stylesheet_tag }}

{%- style -%}
  .footer {
    margin-top: {{ section.settings.margin_top | times: 0.75 | round: 0 }}px;
  }

  .section-{{ section.id }}-padding {
    padding-top: {{ section.settings.padding_top | times: 0.75 | round: 0 }}px;
    padding-bottom: {{ section.settings.padding_bottom | times: 0.75 | round: 0 }}px;
  }

  @media screen and (min-width: 750px) {
    .footer {
      margin-top: {{ section.settings.margin_top }}px;
    }

    .section-{{ section.id }}-padding {
      padding-top: {{ section.settings.padding_top }}px;
      padding-bottom: {{ section.settings.padding_bottom }}px;
    }

    .vlora-footer .footer__content-top {
      max-width: var(--page-width);
      padding-top: 46px;
      padding-bottom: 42px;
    }

    .vlora-footer .footer__blocks-wrapper {
      display: contents;
    }

    .vlora-footer .footer__content-top {
      display: grid;
      grid-template-columns: 1.2fr repeat(3, minmax(0, 1fr)) 1.35fr;
      gap: 32px;
      align-items: start;
    }

    .vlora-footer .footer-block {
      width: auto;
      padding: 0;
    }

    .vlora-footer .footer-block--newsletter {
      grid-column: 5;
      grid-row: 1;
      width: auto;
      margin: 0;
      padding: 0;
      align-items: stretch;
    }

    .vlora-footer .footer-block__heading {
      margin: 0 0 14px;
      color: rgb(var(--color-foreground));
      font-size: 12px;
      font-weight: 700;
      letter-spacing: .01em;
    }

    .vlora-footer .footer-block__details-content {
      margin: 0;
    }

    .vlora-footer .footer-block__details-content .list-menu__item--link {
      min-height: 0;
      padding: 3px 0;
      color: rgba(var(--color-foreground), .72);
      font-size: 12px;
      line-height: 1.35;
    }

    .vlora-footer .footer-block__details-content .list-menu__item--link:hover {
      color: rgb(var(--color-foreground));
    }

    .vlora-footer .footer-block__brand-info {
      margin: 0;
    }

    .vlora-footer__wordmark {
      display: inline-flex;
      flex-direction: column;
      align-items: center;
      color: rgb(var(--color-foreground));
      line-height: 1;
    }

    .vlora-footer__wordmark-name {
      font-family: var(--font-heading-family);
      font-size: 25px;
      letter-spacing: .13em;
    }

    .vlora-footer__wordmark-country {
      margin-top: 5px;
      font-size: 8px;
      font-weight: 600;
      letter-spacing: .42em;
    }

    .vlora-footer__tagline {
      max-width: 150px;
      margin: 10px 0 0;
      color: rgba(var(--color-foreground), .62);
      font-size: 12px;
      line-height: 1.35;
    }

    .vlora-footer__follow {
      margin-bottom: 24px;
    }

    .vlora-footer__follow .footer-block__heading {
      margin-bottom: 10px;
    }

    .vlora-footer__follow .footer__list-social {
      justify-content: center;
      margin: 0;
    }

    .vlora-footer .footer-block__newsletter {
      display: block;
    }

    .vlora-footer .footer-block__newsletter .footer-block__heading {
      margin-bottom: 10px;
    }

    .vlora-footer .footer__newsletter {
      max-width: 100%;
      margin: 0;
    }

    .vlora-footer .newsletter-form__field-wrapper .field {
      min-height: 42px;
    }

    .vlora-footer .newsletter-form__field-wrapper .field__input {
      min-height: 42px;
      padding: 0 44px 0 12px;
      border-color: rgba(var(--color-foreground), .18);
      background: rgba(255, 255, 255, .7);
      font-size: 12px;
    }

    .vlora-footer .newsletter-form__button {
      width: 42px;
      height: 42px;
      background: rgb(var(--color-button));
      color: rgb(var(--color-button-text));
    }

    .vlora-footer .footer__content-bottom {
      position: relative;
      border-top: 1px solid rgba(var(--color-foreground), .12);
    }

    .vlora-footer .footer__content-bottom-wrapper:first-child {
      position: absolute;
      top: 50%;
      right: max(2rem, calc((100vw - var(--page-width)) / 2));
      width: auto;
      padding: 0;
      transform: translateY(-50%);
    }

    .vlora-footer .footer__content-bottom-wrapper:first-child .footer__localization {
      display: none;
    }

    .vlora-footer .footer__content-bottom-wrapper:last-child {
      max-width: var(--page-width);
      min-height: 58px;
      padding-top: 14px;
      padding-bottom: 14px;
      align-items: center;
    }

    .vlora-footer .footer__copyright {
      color: rgba(var(--color-foreground), .68);
      font-size: 12px;
    }

    .vlora-footer .footer__copyright .copyright__content {
      font-size: 12px;
    }

    .vlora-footer .footer__payment .list-payment {
      justify-content: flex-end;
      margin: 0;
    }

    .vlora-footer .footer__payment .list-payment__item {
      padding: 0 2px;
    }

    .vlora-footer__accordion-summary {
      display: flex;
      align-items: center;
      justify-content: space-between;
      list-style: none;
    }

    .vlora-footer__accordion-summary::-webkit-details-marker {
      display: none;
    }

    .vlora-footer__accordion-summary .footer-block__heading {
      margin-bottom: 14px;
    }

    .vlora-footer__accordion-icon {
      display: none;
    }

    .vlora-footer__accordion-content {
      display: block !important;
    }

    .vlora-footer__accordion:not([open]) > .vlora-footer__accordion-content {
      display: block !important;
    }

    .vlora-footer__accordion > summary {
      cursor: default;
    }
  }

  @media screen and (max-width: 749px) {
    .vlora-footer .footer__content-top {
      padding-top: 34px;
      padding-bottom: 28px;
    }

    .vlora-footer .footer__blocks-wrapper {
      display: grid;
      gap: 0;
    }

    .vlora-footer .footer-block {
      padding: 15px 0;
      border-bottom: 1px solid rgba(var(--color-foreground), .12);
    }

    .vlora-footer .footer-block:first-child {
      padding-top: 0;
      border-bottom: 0;
    }

    .vlora-footer .footer-block--menu .footer-block__heading,
    .vlora-footer .vlora-footer__link-group .footer-block__heading {
      margin-bottom: 8px;
    }

    .vlora-footer__accordion-summary {
      cursor: pointer;
    }

    .vlora-footer__accordion-summary .footer-block__heading {
      margin: 0;
    }

    .vlora-footer__accordion-icon {
      display: inline-block;
      color: rgba(var(--color-foreground), .65);
      font-size: 22px;
      font-weight: 300;
      line-height: 1;
      transition: transform .2s ease;
    }

    .vlora-footer__accordion[open] .vlora-footer__accordion-icon {
      transform: rotate(45deg);
    }

    .vlora-footer__accordion-content {
      margin-top: 10px;
    }

    .vlora-footer .footer-block--newsletter {
      grid-column: auto;
      grid-row: auto;
      padding-top: 22px;
    }

    .vlora-footer .footer-block__details-content .list-menu__item--link {
      font-size: 12px;
    }

    .vlora-footer__wordmark-name {
      font-size: 23px;
    }

    .vlora-footer .footer__content-bottom {
      padding-top: 18px;
    }

    .vlora-footer .footer__content-bottom-wrapper:first-child {
      position: static;
      transform: none;
    }

    .vlora-footer .footer__content-bottom-wrapper:first-child .footer__column--info {
      justify-content: center;
    }

    .vlora-footer .footer__content-bottom-wrapper:last-child {
      min-height: 0;
      padding-top: 16px;
      padding-bottom: 20px;
      justify-content: center;
      text-align: center;
    }

    .vlora-footer .footer__copyright {
      justify-content: center;
      flex-wrap: wrap;
      gap: 4px 10px;
    }
  }
{%- endstyle -%}

<footer class="footer vlora-footer color-{{ section.settings.color_scheme }} gradient section-{{ section.id }}-padding">
  {%- liquid
    assign has_social_icons = true
    if settings.social_facebook_link == blank and settings.social_instagram_link == blank and settings.social_youtube_link == blank and settings.social_tiktok_link == blank and settings.social_twitter_link == blank and settings.social_pinterest_link == blank and settings.social_snapchat_link == blank and settings.social_tumblr_link == blank and settings.social_vimeo_link == blank
      assign has_social_icons = false
    endif

    if settings.brand_image == blank and settings.brand_headline == blank and settings.brand_description == blank
      assign brand_empty = true
    endif

    if section.blocks.size == 1 and section.blocks[0].type == 'brand_information' and brand_empty and has_social_icons == false and section.settings.newsletter_enable == false and section.settings.enable_follow_on_shop == false
      assign only_empty_brand = true
    endif
  -%}
  {%- if section.blocks.size > 0
    or section.settings.newsletter_enable
    or section.settings.show_social
    and has_social_icons == true
    or section.settings.enable_follow_on_shop
  -%}
    {%- unless only_empty_brand -%}
      <div class="footer__content-top page-width">
        {%- if section.blocks.size > 0 -%}
          {%- liquid
            if section.blocks.size == 9
              assign footer_grid_class = 'grid--3-col-tablet'
            elsif section.blocks.size > 6
              assign footer_grid_class = 'grid--4-col-desktop'
            elsif section.blocks.size > 4
              assign footer_grid_class = 'grid--3-col-tablet'
            endif
          -%}
          <div
            class="footer__blocks-wrapper grid grid--1-col grid--2-col grid--4-col-tablet {{ footer_grid_class }}{% if settings.animations_reveal_on_scroll %} scroll-trigger animate--slide-in{% endif %}"
            {% if settings.animations_reveal_on_scroll %}
              data-cascade
            {% endif %}
          >
            {%- for block in section.blocks -%}
              <div
                class="footer-block grid__item{% if block.type == 'link_list' %} footer-block--menu{% endif %}{% if settings.animations_reveal_on_scroll %} scroll-trigger animate--slide-in{% endif %}"
                {{ block.shopify_attributes }}
                {% if settings.animations_reveal_on_scroll %}
                  data-cascade
                  style="--animation-order: {{ forloop.index }};"
                {% endif %}
              >
                {%- if block.settings.heading != blank and block.type != 'vlora_link_group' and block.type != 'link_list' -%}
                  <h2 class="footer-block__heading inline-richtext">{{- block.settings.heading -}}</h2>
                {%- endif -%}

                {%- case block.type -%}
                  {%- when '@app' -%}
                    {% render block %}
                  {%- when 'text' -%}
                    <div class="footer-block__details-content rte">
                      {{ block.settings.subtext }}
                    </div>
                  {%- when 'link_list' -%}
                    {%- if block.settings.menu != blank -%}
                      <details class="vlora-footer__accordion">
                        <summary class="vlora-footer__accordion-summary">
                          <span class="footer-block__heading inline-richtext">{{ block.settings.heading }}</span>
                          <span class="vlora-footer__accordion-icon" aria-hidden="true">+</span>
                        </summary>
                        <ul class="footer-block__details-content list-unstyled vlora-footer__accordion-content">
                          {%- for link in block.settings.menu.links -%}
                            <li>
                              <a
                                href="{{ link.url }}"
                                class="link link--text list-menu__item list-menu__item--link{% if link.active %} list-menu__item--active{% endif %}"
                              >
                                {{ link.title | escape }}
                              </a>
                            </li>
                          {%- endfor -%}
                        </ul>
                      </details>
                    {%- endif -%}
                  {%- when 'brand_information' -%}
                    <div class="footer-block__brand-info">
                      {%- if settings.brand_image != blank -%}
                        {%- assign brand_image_height = settings.brand_image_width
                          | divided_by: settings.brand_image.aspect_ratio
                        -%}
                        <div
                          class="footer-block__image-wrapper"
                          style="max-width: min(100%, {{ settings.brand_image_width }}px);"
                        >
                          {{
                            settings.brand_image
                            | image_url: width: 1100
                            | image_tag:
                              loading: 'lazy',
                              widths: '50, 100, 150, 200, 300, 400, 550, 800, 1100',
                              height: brand_image_height,
                              width: settings.brand_image_width
                          }}
                        </div>
                      {%- endif -%}
                      {%- if settings.brand_headline != blank -%}
                        <h2 class="footer-block__heading rte">{{ settings.brand_headline }}</h2>
                      {%- endif -%}
                      {%- if settings.brand_description != blank -%}
                        <div class="rte">{{ settings.brand_description }}</div>
                      {%- elsif settings.brand_image == blank and settings.brand_headline == blank -%}
                        <div class="vlora-footer__wordmark" aria-label="Vlora India">
                          <span class="vlora-footer__wordmark-name">VLORA</span>
                          <span class="vlora-footer__wordmark-country">INDIA</span>
                        </div>
                        <p class="vlora-footer__tagline">Tiny moments, beautifully preserved.</p>
                      {%- endif -%}
                      {%- if block.settings.show_social and has_social_icons -%}
                        {%- render 'social-icons', class: 'footer__list-social' -%}
                      {%- endif -%}
                    </div>
                  {%- when 'vlora_link_group' -%}
                    <details class="vlora-footer__accordion vlora-footer__link-group">
                      <summary class="vlora-footer__accordion-summary">
                        <span class="footer-block__heading inline-richtext">{{ block.settings.heading }}</span>
                        <span class="vlora-footer__accordion-icon" aria-hidden="true">+</span>
                      </summary>
                      <ul class="footer-block__details-content list-unstyled vlora-footer__accordion-content">
                        {%- for index in (1..5) -%}
                          {%- assign label_key = 'link_' | append: index | append: '_label' -%}
                          {%- assign url_key = 'link_' | append: index | append: '_url' -%}
                          {%- if block.settings[label_key] != blank -%}
                            {%- assign link_url = block.settings[url_key] -%}
                            {%- if link_url == blank -%}
                              {%- assign link_url = routes.root_url -%}
                            {%- endif -%}
                            <li>
                              <a href="{{ link_url }}" class="link link--text list-menu__item list-menu__item--link">
                                {{ block.settings[label_key] | escape }}
                              </a>
                            </li>
                          {%- endif -%}
                        {%- endfor -%}
                      </ul>
                    </details>
                  {%- when 'image' -%}
                    <div class="footer-block__details-content footer-block-image {{ block.settings.alignment }}">
                      {%- if block.settings.image != blank -%}
                        {%- assign image_size_2x = block.settings.image_width | times: 2 | at_most: 5760 -%}
                        <div
                          class="footer-block__image-wrapper"
                          style="max-width: min(100%, {{ block.settings.image_width }}px);"
                        >
                          <img
                            srcset="{{ block.settings.image | image_url: width: block.settings.image_width }}, {{ block.settings.image | image_url: width: image_size_2x }} 2x"
                            src="{{ block.settings.image | image_url: width: 760 }}"
                            alt="{{ block.settings.image.alt | escape }}"
                            loading="lazy"
                            width="{{ block.settings.image.width }}"
                            height="{{ block.settings.image.height }}"
                          >
                        </div>
                      {%- else -%}
                        {{ 'image' | placeholder_svg_tag: 'placeholder-svg placeholder' }}
                      {%- endif -%}
                    </div>
                {%- endcase -%}
              </div>
            {%- endfor -%}
          </div>
        {%- endif -%}

        <div
          class="footer-block--newsletter{% if settings.animations_reveal_on_scroll %} scroll-trigger animate--slide-in{% endif %}"
          {% if settings.animations_reveal_on_scroll %}
            data-cascade
          {% endif %}
        >
          {%- if section.settings.newsletter_enable -%}
            <div class="footer-block__newsletter">
              {%- if section.settings.show_social and has_social_icons -%}
                <div class="vlora-footer__follow">
                  <h2 class="footer-block__heading inline-richtext">Follow Us</h2>
                  {%- render 'social-icons', class: 'footer__list-social' -%}
                </div>
              {%- endif -%}
              {%- if section.settings.newsletter_heading != blank -%}
                <h2 class="footer-block__heading inline-richtext">{{ section.settings.newsletter_heading }}</h2>
              {%- endif -%}
              {%- form 'customer', id: 'ContactFooter', class: 'footer__newsletter newsletter-form' -%}
                <input type="hidden" name="contact[tags]" value="newsletter">
                <div class="newsletter-form__field-wrapper">
                  <div class="field">
                    <input
                      id="NewsletterForm--{{ section.id }}"
                      type="email"
                      name="contact[email]"
                      class="field__input"
                      value="{{ form.email }}"
                      aria-required="true"
                      autocorrect="off"
                      autocapitalize="off"
                      autocomplete="email"
                      {% if form.errors %}
                        autofocus
                        aria-invalid="true"
                        aria-describedby="ContactFooter-error"
                      {% elsif form.posted_successfully? %}
                        aria-describedby="ContactFooter-success"
                      {% endif %}
                      placeholder="{{ 'newsletter.label' | t }}"
                      required
                    >
                    <label class="field__label" for="NewsletterForm--{{ section.id }}">
                      {{ 'newsletter.label' | t }}
                    </label>
                    <button
                      type="submit"
                      class="newsletter-form__button field__button"
                      name="commit"
                      id="Subscribe"
                      aria-label="{{ 'newsletter.button_label' | t }}"
                    >
                      <span class="svg-wrapper">
                        {{- 'icon-arrow.svg' | inline_asset_content -}}
                      </span>
                    </button>
                  </div>
                  {%- if form.errors -%}
                    <small class="newsletter-form__message form__message" id="ContactFooter-error">
                      <span class="svg-wrapper">
                        {{- 'icon-error.svg' | inline_asset_content -}}
                      </span>
                      {{- form.errors.translated_fields.email | capitalize }}
                      {{ form.errors.messages.email -}}
                    </small>
                  {%- endif -%}
                </div>
                {%- if form.posted_successfully? -%}
                  <h3
                    class="newsletter-form__message newsletter-form__message--success form__message"
                    id="ContactFooter-success"
                    tabindex="-1"
                    autofocus
                  >
                    <span class="svg-wrapper">
                      {{- 'icon-success.svg' | inline_asset_content -}}
                    </span>
                    {{- 'newsletter.success' | t }}
                  </h3>
                {%- endif -%}
              {%- endform -%}
            </div>
          {%- endif -%}

          {%- if shop.features.follow_on_shop? and section.settings.enable_follow_on_shop -%}
            <div class="footer__follow-on-shop">
              {{ shop | login_button: action: 'follow' }}
            </div>
          {%- endif -%}

        </div>
      </div>
    {%- endunless -%}
  {%- endif -%}

  <div
    class="footer__content-bottom{% if settings.animations_reveal_on_scroll %} scroll-trigger animate--slide-in{% endif %}"
    {% if settings.animations_reveal_on_scroll %}
      data-cascade
    {% endif %}
  >
    <div class="footer__content-bottom-wrapper page-width">
      <div class="footer__column footer__localization isolate">
        {%- if section.settings.enable_country_selector and localization.available_countries.size > 1 -%}
          <localization-form>
            {%- form 'localization', id: 'FooterCountryForm', class: 'localization-form' -%}
              <div>
                <h2 class="caption-large text-body" id="FooterCountryLabel">{{ 'localization.country_label' | t }}</h2>
                {%- render 'country-localization', localPosition: 'FooterCountry' -%}
              </div>
            {%- endform -%}
          </localization-form>
        {%- endif -%}

        {%- if section.settings.enable_language_selector and localization.available_languages.size > 1 -%}
          <localization-form>
            {%- form 'localization', id: 'FooterLanguageForm', class: 'localization-form' -%}
              <div>
                <h2 class="caption-large text-body" id="FooterLanguageLabel">
                  {{ 'localization.language_label' | t }}
                </h2>
                {%- render 'language-localization', localPosition: 'FooterLanguage' -%}
              </div>
            {%- endform -%}
          </localization-form>
        {%- endif -%}
      </div>
      <div class="footer__column footer__column--info">
        {%- if section.settings.payment_enable -%}
          <div class="footer__payment">
            <span class="visually-hidden">{{ 'sections.footer.payment' | t }}</span>
            <ul class="list list-payment" role="list">
              {%- for type in shop.enabled_payment_types -%}
                <li class="list-payment__item">
                  {{ type | payment_type_svg_tag: class: 'icon icon--full-color' }}
                </li>
              {%- endfor -%}
            </ul>
          </div>
        {%- endif -%}
      </div>
    </div>
    <div class="footer__content-bottom-wrapper page-width{% if section.settings.enable_country_selector == false and section.settings.enable_language_selector == false %} footer__content-bottom-wrapper--center{% endif %}">
      <div class="footer__copyright caption">
        <small class="copyright__content"
          >&copy; {{ 'now' | date: '%Y' }}, {{ shop.name | link_to: routes.root_url -}}
        </small>
        <small class="copyright__content">{{ powered_by_link }}</small>
        {%- if section.settings.show_policy -%}
          <ul class="policies list-unstyled">
            {%- for policy in shop.policies -%}
              {%- if policy != blank -%}
                <li>
                  <small class="copyright__content"
                    ><a href="{{ policy.url }}">{{ policy.title | escape }}</a></small
                  >
                </li>
              {%- endif -%}
            {%- endfor -%}
          </ul>
        {%- endif -%}
      </div>
    </div>
  </div>
</footer>

<script>
  (() => {
    const footer = document.querySelector('.vlora-footer');
    if (!footer) return;

    const accordions = footer.querySelectorAll('.vlora-footer__accordion');
    const desktopQuery = window.matchMedia('(min-width: 750px)');

    const syncFooterMenus = () => {
      accordions.forEach((accordion) => {
        if (desktopQuery.matches) {
          accordion.setAttribute('open', '');
        } else {
          accordion.removeAttribute('open');
        }
      });
    };

    syncFooterMenus();
    desktopQuery.addEventListener('change', syncFooterMenus);
  })();
</script>

{% schema %}
{
  "name": "t:sections.footer.name",
  "blocks": [
    {
      "type": "@app"
    },
    {
      "type": "link_list",
      "name": "t:sections.footer.blocks.link_list.name",
      "settings": [
        {
          "type": "inline_richtext",
          "id": "heading",
          "default": "t:sections.footer.blocks.link_list.settings.heading.default",
          "label": "t:sections.footer.blocks.link_list.settings.heading.label"
        },
        {
          "type": "link_list",
          "id": "menu",
          "default": "footer",
          "label": "t:sections.footer.blocks.link_list.settings.menu.label"
        }
      ]
    },
    {
      "type": "vlora_link_group",
      "name": "Vlora link group",
      "settings": [
        { "type": "text", "id": "heading", "label": "Column heading", "default": "Shop" },
        { "type": "text", "id": "link_1_label", "label": "Link 1 label", "default": "Shop All" },
        { "type": "url", "id": "link_1_url", "label": "Link 1 URL" },
