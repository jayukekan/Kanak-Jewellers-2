{{ 'jk-circle-collections.css' | asset_url | stylesheet_tag }}

{%- liquid
  case section.settings.alignment
    when 'left'
      assign list_alignment = 'flex-start'
    when 'right'
      assign list_alignment = 'flex-end'
    else
      assign list_alignment = 'center'
  endcase
-%}

<section
  class="xc-circle-collections color-{{ section.settings.color_scheme }} gradient"
  style="--xc-padding-top: {{ section.settings.padding_top }}px; --xc-padding-bottom: {{ section.settings.padding_bottom }}px; --xc-image-size: {{ section.settings.image_size }}px; --xc-mobile-image-size: {{ section.settings.mobile_image_size }}px; --xc-card-gap: {{ section.settings.card_gap }}px; --xc-mobile-gap: {{ section.settings.mobile_gap }}px; --xc-label-gap: {{ section.settings.label_gap }}px; --xc-mobile-label-gap: {{ section.settings.mobile_label_gap }}px; --xc-label-size: {{ section.settings.label_size | divided_by: 10.0 }}rem; --xc-border-width: {{ section.settings.border_width }}px; --xc-border-color: {{ section.settings.border_color }}; --xc-list-alignment: {{ list_alignment }};"
>
  <div class="{% unless section.settings.full_width %}page-width{% else %}xc-circle-collections__full-width{% endunless %}">
    {%- if section.settings.heading != blank -%}
      <h2 class="xc-circle-collections__heading xc-circle-collections__heading--{{ section.settings.heading_alignment }} {{ section.settings.heading_size }}">
        {{ section.settings.heading | escape }}
      </h2>
    {%- endif -%}

    <div class="xc-circle-collections__scroller">
      <ul class="xc-circle-collections__list" role="list">
        {%- for block in section.blocks -%}
          {%- liquid
            assign card_collection = block.settings.collection
            assign card_image = block.settings.image | default: card_collection.featured_image
            assign card_title = block.settings.title | default: card_collection.title
            assign card_link = block.settings.link | default: card_collection.url | default: routes.all_products_collection_url
          -%}
          <li class="xc-circle-collections__item" {{ block.shopify_attributes }}>
            <a class="xc-circle-collections__link" href="{{ card_link }}">
              <span class="xc-circle-collections__media">
                {%- if card_image != blank -%}
                  {{
                    card_image
                    | image_url: width: 500
                    | image_tag:
                      class: 'xc-circle-collections__image',
                      loading: 'lazy',
                      widths: '100, 150, 200, 250, 300, 400, 500',
                      sizes: '(min-width: 750px) 180px, 120px'
                  }}
                {%- else -%}
                  <span class="xc-circle-collections__placeholder">
                    {{ 'collection-1' | placeholder_svg_tag }}
                  </span>
                {%- endif -%}
              </span>
              {%- if card_title != blank -%}<span class="xc-circle-collections__title">{{ card_title | escape }}</span>{%- endif -%}
            </a>
          </li>
        {%- endfor -%}
      </ul>
    </div>
  </div>
</section>

{% schema %}
{
  "name": "jk circle links",
  "tag": "section",
  "class": "section-xc-circle-collections",
  "max_blocks": 12,
  "settings": [
    { "type": "text", "id": "heading", "label": "Heading" },
    {
      "type": "select",
      "id": "heading_size",
      "label": "Heading size",
      "options": [
        { "value": "h2", "label": "Small" },
        { "value": "h1", "label": "Medium" },
        { "value": "h0", "label": "Large" }
      ],
      "default": "h1"
    },
    {
      "type": "text_alignment",
      "id": "heading_alignment",
      "label": "Heading alignment",
      "default": "center"
    },
    { "type": "checkbox", "id": "full_width", "label": "Make section full width", "default": false },
    {
      "type": "select",
      "id": "alignment",
      "label": "Items alignment",
      "options": [
        { "value": "left", "label": "Left" },
        { "value": "center", "label": "Center" },
        { "value": "right", "label": "Right" }
      ],
      "default": "center"
    },
    { "type": "color_scheme", "id": "color_scheme", "label": "Color scheme", "default": "scheme-2" },
    { "type": "header", "content": "Desktop layout" },
    { "type": "range", "id": "image_size", "min": 80, "max": 200, "step": 4, "unit": "px", "label": "Circle size", "default": 124 },
    { "type": "range", "id": "card_gap", "min": 4, "max": 48, "step": 2, "unit": "px", "label": "Space between items", "default": 16 },
    { "type": "range", "id": "label_gap", "min": 4, "max": 40, "step": 2, "unit": "px", "label": "Image to label spacing", "default": 24 },
    { "type": "range", "id": "label_size", "min": 10, "max": 24, "step": 1, "unit": "px", "label": "Label size", "default": 14 },
    { "type": "header", "content": "Mobile layout" },
    { "type": "range", "id": "mobile_image_size", "min": 72, "max": 140, "step": 4, "unit": "px", "label": "Circle size", "default": 96 },
    { "type": "range", "id": "mobile_gap", "min": 4, "max": 32, "step": 2, "unit": "px", "label": "Space between items", "default": 14 },
    { "type": "range", "id": "mobile_label_gap", "min": 4, "max": 28, "step": 2, "unit": "px", "label": "Image to label spacing", "default": 14 },
    { "type": "header", "content": "Circle border" },
    { "type": "range", "id": "border_width", "min": 0, "max": 6, "step": 1, "unit": "px", "label": "Border width", "default": 0 },
    { "type": "color", "id": "border_color", "label": "Border color", "default": "#d8d2cf" },
    { "type": "header", "content": "Section spacing" },
    { "type": "range", "id": "padding_top", "min": 0, "max": 120, "step": 4, "unit": "px", "label": "Top padding", "default": 64 },
    { "type": "range", "id": "padding_bottom", "min": 0, "max": 120, "step": 4, "unit": "px", "label": "Bottom padding", "default": 72 }
  ],
  "blocks": [
    {
      "type": "collection",
      "name": "Collection",
      "settings": [
        { "type": "collection", "id": "collection", "label": "Collection" },
        { "type": "image_picker", "id": "image", "label": "Custom image" },
        { "type": "text", "id": "title", "label": "Custom label" },
        { "type": "url", "id": "link", "label": "Custom link" }
      ]
    }
  ],
  "presets": [
    {
      "name": "jk circle links",
      "blocks": [
        { "type": "collection" },
        { "type": "collection" },
        { "type": "collection" },
        { "type": "collection" },
        { "type": "collection" },
        { "type": "collection" },
        { "type": "collection" }
      ]
    }
  ]
}
{% endschema %}
