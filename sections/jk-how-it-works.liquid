{% comment %}
  VLORA — How it works
  Numbered four-step process with images and responsive mobile rail.
{% endcomment %}

{% liquid
  assign section_id = 'vlora-how-' | append: section.id
%}

<section
  id="{{ section_id }}"
  class="vlora-how"
  aria-labelledby="{{ section_id }}-heading"
  style="
    --vh-bg: {{ section.settings.background_color }};
    --vh-text: {{ section.settings.text_color }};
    --vh-muted: {{ section.settings.subtext_color }};
    --vh-accent: {{ section.settings.accent_color }};
    --vh-line: {{ section.settings.line_color }};
    --vh-radius: {{ section.settings.image_radius }}px;
  "
>
  <div class="vlora-how__inner page-width">
    <header class="vlora-how__header">
      {% if section.settings.eyebrow != blank %}
        <p class="vlora-how__eyebrow">{{ section.settings.eyebrow | escape }}</p>
      {% endif %}
      {% if section.settings.heading != blank %}
        <h2 id="{{ section_id }}-heading" class="vlora-how__heading">{{ section.settings.heading }}</h2>
      {% endif %}
      {% if section.settings.subheading != blank %}
        <div class="vlora-how__subheading rte">{{ section.settings.subheading }}</div>
      {% endif %}
    </header>

    <div class="vlora-how__steps" role="list">
      {% for block in section.blocks %}
        <article class="vlora-how__step" role="listitem" {{ block.shopify_attributes }}>
          <div class="vlora-how__step-head">
            <span class="vlora-how__number">{{ forloop.index | prepend: '0' | slice: -2, 2 }}</span>
            {% if block.settings.title != blank %}
              <h3 class="vlora-how__step-title">{{ block.settings.title | escape }}</h3>
            {% endif %}
          </div>

          {% if block.settings.link != blank %}<a class="vlora-how__media" href="{{ block.settings.link }}">{% else %}<div class="vlora-how__media">{% endif %}
            {% if block.settings.image != blank %}
              {{
                block.settings.image
                | image_url: width: 900
                | image_tag:
                  loading: 'lazy',
                  widths: '240, 360, 480, 720, 900',
                  sizes: '(max-width: 749px) 72vw, 25vw',
                  class: 'vlora-how__image',
                  alt: block.settings.title
              }}
            {% else %}
              {{ 'product-1' | placeholder_svg_tag: 'vlora-how__placeholder placeholder-svg' }}
            {% endif %}
          {% if block.settings.link != blank %}</a>{% else %}</div>{% endif %}

          {% if block.settings.description != blank %}
            <div class="vlora-how__description rte">{{ block.settings.description }}</div>
          {% endif %}
        </article>
      {% endfor %}
    </div>
  </div>
</section>

<style>
  #{{ section_id }} {
    width: 100%;
    background: var(--vh-bg);
    color: var(--vh-text);
  }

  #{{ section_id }} * { box-sizing: border-box; }

  #{{ section_id }} .vlora-how__inner {
    max-width: 1440px;
    padding-top: {{ section.settings.padding_top }}px;
    padding-bottom: {{ section.settings.padding_bottom }}px;
  }

  #{{ section_id }} .vlora-how__header {
    max-width: 760px;
    margin: 0 auto 28px;
    text-align: center;
  }

  #{{ section_id }} .vlora-how__eyebrow {
    margin: 0 0 5px;
    color: var(--vh-accent);
    font-size: 12px;
    font-weight: 700;
    line-height: 1.2;
  }

  #{{ section_id }} .vlora-how__heading {
    margin: 0;
    color: inherit;
    font-family: var(--font-heading-family);
    font-size: {{ section.settings.heading_size }}px;
    font-weight: 600;
    line-height: 1.15;
  }

  #{{ section_id }} .vlora-how__subheading {
    margin-top: 8px;
    color: var(--vh-muted);
    font-size: 13px;
  }

  #{{ section_id }} .vlora-how__subheading p,
  #{{ section_id }} .vlora-how__description p { margin: 0; }

  #{{ section_id }} .vlora-how__steps {
    position: relative;
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: {{ section.settings.step_gap }}px;
  }

  #{{ section_id }} .vlora-how__steps::before {
    content: '';
    position: absolute;
    z-index: 0;
    top: 18px;
    right: 10%;
    left: 10%;
    height: 1px;
    background: var(--vh-line);
  }

  #{{ section_id }} .vlora-how__step {
    position: relative;
    z-index: 1;
    min-width: 0;
    text-align: center;
  }

  #{{ section_id }} .vlora-how__step-head {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    margin-bottom: 14px;
    padding: 0 10px;
    background: var(--vh-bg);
  }

  #{{ section_id }} .vlora-how__number {
    display: grid;
    flex: 0 0 36px;
    width: 36px;
    height: 36px;
    place-items: center;
    border-radius: 50%;
    background: var(--vh-accent);
    color: #fff;
    font-size: 11px;
    font-weight: 700;
    letter-spacing: 0.04em;
  }

  #{{ section_id }} .vlora-how__step-title {
    margin: 0;
    color: var(--vh-muted);
    font-family: var(--font-body-family);
    font-size: 12px;
    font-weight: 700;
    line-height: 1.2;
  }

  #{{ section_id }} .vlora-how__media {
    display: block;
    width: 100%;
    aspect-ratio: 4 / 3;
    overflow: hidden;
    border-radius: var(--vh-radius);
    background: #eee7e1;
    color: inherit;
    box-shadow: 0 3px 14px rgba(58, 39, 31, 0.06);
  }

  #{{ section_id }} .vlora-how__image,
  #{{ section_id }} .vlora-how__placeholder {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 300ms ease;
  }

  #{{ section_id }} a.vlora-how__media:hover .vlora-how__image { transform: scale(1.025); }

  #{{ section_id }} .vlora-how__description {
    max-width: 230px;
    margin: 12px auto 0;
    color: var(--vh-text);
    font-size: 12px;
    line-height: 1.45;
  }

  @media screen and (max-width: 989px) {
    #{{ section_id }} .vlora-how__steps { grid-template-columns: repeat(2, minmax(0, 1fr)); row-gap: 28px; }
    #{{ section_id }} .vlora-how__steps::before { display: none; }
  }

  @media screen and (max-width: 749px) {
    #{{ section_id }} .vlora-how__inner {
      padding-top: {{ section.settings.mobile_padding_top }}px;
      padding-bottom: {{ section.settings.mobile_padding_bottom }}px;
    }

    #{{ section_id }} .vlora-how__header { margin-bottom: 22px; padding: 0 8px; }
    #{{ section_id }} .vlora-how__heading { font-size: {{ section.settings.mobile_heading_size }}px; }
    #{{ section_id }} .vlora-how__steps {
      grid-template-columns: none;
      grid-auto-columns: min(76vw, 300px);
      grid-auto-flow: column;
      gap: 14px;
      margin-right: -1.5rem;
      padding-right: 1.5rem;
      overflow-x: auto;
      overscroll-behavior-inline: contain;
      scroll-snap-type: inline mandatory;
      scrollbar-width: none;
    }
    #{{ section_id }} .vlora-how__steps::-webkit-scrollbar { display: none; }
    #{{ section_id }} .vlora-how__step { scroll-snap-align: start; }
    #{{ section_id }} .vlora-how__step-head { margin-bottom: 12px; }
    #{{ section_id }} .vlora-how__description { font-size: 12px; }
  }
</style>

{% schema %}
{
  "name": "VLORA How it works",
  "tag": "section",
  "class": "section",
  "disabled_on": { "groups": ["header", "footer"] },
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "How It Works" },
    { "type": "inline_richtext", "id": "heading", "label": "Heading", "default": "A Forever Memory in Just a Few Simple Steps" },
    { "type": "richtext", "id": "subheading", "label": "Subheading" },
    { "type": "range", "id": "heading_size", "min": 22, "max": 52, "step": 1, "unit": "px", "label": "Desktop heading size", "default": 30 },
    { "type": "range", "id": "mobile_heading_size", "min": 20, "max": 36, "step": 1, "unit": "px", "label": "Mobile heading size", "default": 25 },
    { "type": "range", "id": "step_gap", "min": 8, "max": 36, "step": 2, "unit": "px", "label": "Step gap", "default": 24 },
    { "type": "range", "id": "image_radius", "min": 0, "max": 30, "step": 2, "unit": "px", "label": "Image corner radius", "default": 14 },
    { "type": "color", "id": "background_color", "label": "Background", "default": "#fffaf6" },
    { "type": "color", "id": "text_color", "label": "Text", "default": "#241d1a" },
    { "type": "color", "id": "subtext_color", "label": "Muted text", "default": "#6f6661" },
    { "type": "color", "id": "accent_color", "label": "Step number", "default": "#c98282" },
    { "type": "color", "id": "line_color", "label": "Connector line", "default": "#ead9d2" },
    { "type": "range", "id": "padding_top", "min": 0, "max": 100, "step": 4, "unit": "px", "label": "Desktop top padding", "default": 48 },
    { "type": "range", "id": "padding_bottom", "min": 0, "max": 100, "step": 4, "unit": "px", "label": "Desktop bottom padding", "default": 48 },
    { "type": "range", "id": "mobile_padding_top", "min": 0, "max": 80, "step": 4, "unit": "px", "label": "Mobile top padding", "default": 36 },
    { "type": "range", "id": "mobile_padding_bottom", "min": 0, "max": 80, "step": 4, "unit": "px", "label": "Mobile bottom padding", "default": 36 }
  ],
  "blocks": [
    {
      "type": "step",
      "name": "Step",
      "settings": [
        { "type": "text", "id": "title", "label": "Short title", "default": "Prepare" },
        { "type": "image_picker", "id": "image", "label": "Image" },
        { "type": "richtext", "id": "description", "label": "Description", "default": "<p>Open your kit and prepare the material.</p>" },
        { "type": "url", "id": "link", "label": "Optional link" }
      ]
    }
  ],
  "max_blocks": 6,
  "presets": [
    {
      "name": "VLORA How it works",
      "blocks": [
        { "type": "step", "settings": { "title": "Prepare", "description": "<p>Open your kit and prepare the material.</p>" } },
        { "type": "step", "settings": { "title": "Press", "description": "<p>Capture their tiny hand or footprint.</p>" } },
        { "type": "step", "settings": { "title": "Create", "description": "<p>Add the finishing touches.</p>" } },
        { "type": "step", "settings": { "title": "Forever", "description": "<p>Display your memory at home.</p>" } }
      ]
    }
  ]
}
{% endschema %}
