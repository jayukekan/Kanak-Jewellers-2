      "default": false
    },
    {
      "type": "range",
      "id": "change_slides_speed",
      "min": 3,
      "max": 9,
      "step": 1, 
      "unit": "sec",
      "label": "Change slides every",
      "default": 5
    },
    {
      "type": "checkbox",
      "id":"show_arrows",
      "label": "Enable arrows",
      "default": true
    },
    {
      "type": "checkbox",
