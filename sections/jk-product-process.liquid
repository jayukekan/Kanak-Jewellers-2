{%- style -%}
  #ProductProcess-{{ section.id }} {
    padding-top: {{ section.settings.padding_top | times: 0.75 | round }}px;
    padding-bottom: {{ section.settings.padding_bottom | times: 0.75 | round }}px;
  }

  #ProductProcess-{{ section.id }} .jk-process__header {
    max-width: 76rem;
    margin: 0 auto clamp(3.8rem, 5vw, 6rem);
    text-align: center;
  }

  #ProductProcess-{{ section.id }} .jk-process__eyebrow {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 1rem;
    margin: 0 0 1.2rem;
    color: rgb(var(--color-button));
    font-size: 1.1rem;
    font-weight: 700;
    letter-spacing: .16em;
    text-transform: uppercase;
  }

  #ProductProcess-{{ section.id }} .jk-process__eyebrow:before,
  #ProductProcess-{{ section.id }} .jk-process__eyebrow:after {
    content: '';
    width: 1rem;
    height: .1rem;
    background: currentColor;
  }

  #ProductProcess-{{ section.id }} .jk-process__heading {
    margin: 0;
    font-size: clamp(3.2rem, 4vw, 5rem);
    font-weight: 400;
    line-height: 1.08;
    letter-spacing: -.035em;
  }

  #ProductProcess-{{ section.id }} .jk-process__subheading {
    margin: 1.2rem 0 0;
    color: rgba(var(--color-foreground), .68);
    font-size: 1.5rem;
    line-height: 1.55;
  }

  #ProductProcess-{{ section.id }} .jk-process__timeline {
    max-width: 76rem;
    margin: 0 auto;
  }

  #ProductProcess-{{ section.id }} .jk-process__step {
    position: relative;
    display: grid;
    grid-template-columns: 6.4rem minmax(0, 1fr);
    gap: 2.2rem;
    min-height: 17rem;
  }

  #ProductProcess-{{ section.id }} .jk-process__step:last-child {
    min-height: 0;
  }

  #ProductProcess-{{ section.id }} .jk-process__marker {
    position: relative;
    z-index: 1;
    display: grid;
    width: 5.8rem;
    height: 5.8rem;
    place-items: center;
    border: .7rem solid rgba(var(--color-button), .07);
    border-radius: 50%;
    background: rgb(var(--color-background));
    box-shadow: inset 0 0 0 .1rem rgba(var(--color-button), .12);
    color: rgb(var(--color-button));
    font-size: 2.2rem;
    line-height: 1;
  }

  #ProductProcess-{{ section.id }} .jk-process__icon-image {
    width: 2.8rem;
    height: 2.8rem;
    object-fit: contain;
  }

  #ProductProcess-{{ section.id }} .jk-process__step:not(:last-child) .jk-process__marker:after {
    content: '';
    position: absolute;
    z-index: -1;
    top: 5.1rem;
    left: 50%;
    width: .15rem;
    height: calc(17rem - 4.4rem);
    background: rgba(var(--color-button), .7);
    transform: translateX(-50%);
  }

  #ProductProcess-{{ section.id }} .jk-process__content {
    padding: .8rem 0 4rem;
  }

  #ProductProcess-{{ section.id }} .jk-process__label {
    margin: 0 0 .7rem;
    color: rgb(var(--color-button));
    font-size: 1.05rem;
    font-weight: 700;
    letter-spacing: .14em;
    text-transform: uppercase;
  }

  #ProductProcess-{{ section.id }} .jk-process__title-row {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: .8rem 1.2rem;
  }

  #ProductProcess-{{ section.id }} .jk-process__title {
    margin: 0;
    font-size: clamp(2rem, 2.2vw, 2.7rem);
    font-weight: 400;
    line-height: 1.2;
  }

  #ProductProcess-{{ section.id }} .jk-process__time {
    display: inline-flex;
    align-items: center;
    gap: .4rem;
    padding: .55rem 1rem;
    border: .1rem solid rgba(var(--color-button), .17);
    border-radius: 999px;
    background: rgba(var(--color-button), .08);
    color: rgb(var(--color-button));
    font-size: 1.1rem;
    font-weight: 700;
    line-height: 1;
  }

  #ProductProcess-{{ section.id }} .jk-process__time svg {
    width: 1.2rem;
    height: 1.2rem;
  }

  #ProductProcess-{{ section.id }} .jk-process__description {
    max-width: 65rem;
    margin: 1.2rem 0 0;
    color: rgba(var(--color-foreground), .65);
    font-size: 1.4rem;
    line-height: 1.6;
  }

  @media screen and (min-width: 750px) {
    #ProductProcess-{{ section.id }} {
      padding-top: {{ section.settings.padding_top }}px;
      padding-bottom: {{ section.settings.padding_bottom }}px;
    }
  }

  @media screen and (max-width: 749px) {
    #ProductProcess-{{ section.id }} .jk-process__header {
      margin-bottom: 3.5rem;
    }

    #ProductProcess-{{ section.id }} .jk-process__heading {
      font-size: 2.5rem;
    }

    #ProductProcess-{{ section.id }} .jk-process__subheading {
      font-size: 1.35rem;
    }

    #ProductProcess-{{ section.id }} .jk-process__step {
      grid-template-columns: 4.8rem minmax(0, 1fr);
      gap: 1.3rem;
      min-height: 16rem;
    }

    #ProductProcess-{{ section.id }} .jk-process__marker {
      width: 4.6rem;
      height: 4.6rem;
      border-width: .55rem;
      font-size: 1.8rem;
    }

    #ProductProcess-{{ section.id }} .jk-process__step:not(:last-child) .jk-process__marker:after {
      top: 4rem;
      height: calc(16rem - 3.3rem);
    }

    #ProductProcess-{{ section.id }} .jk-process__content {
      padding-top: .35rem;
      padding-bottom: 3.2rem;
    }

    #ProductProcess-{{ section.id }} .jk-process__title-row {
      align-items: flex-start;
      flex-direction: column;
    }

    #ProductProcess-{{ section.id }} .jk-process__title {
      font-size: 1.9rem;
    }

    #ProductProcess-{{ section.id }} .jk-process__description {
      margin-top: 1rem;
      font-size: 1.3rem;
    }
  }
{%- endstyle -%}

<section id="ProductProcess-{{ section.id }}" class="color-{{ section.settings.color_scheme }} gradient">
  <div class="page-width">
    <header class="jk-process__header">
      {% if section.settings.eyebrow != blank %}
        <p class="jk-process__eyebrow">{{ section.settings.eyebrow | escape }}</p>
      {% endif %}
      {% if section.settings.heading != blank %}
        <h2 class="jk-process__heading">{{ section.settings.heading }}</h2>
      {% endif %}
      {% if section.settings.subheading != blank %}
        <p class="jk-process__subheading">{{ section.settings.subheading | escape }}</p>
      {% endif %}
    </header>

    <div class="jk-process__timeline">
      {% for block in section.blocks %}
        <article class="jk-process__step" {{ block.shopify_attributes }}>
          <div class="jk-process__marker" aria-hidden="true">
            {% if block.settings.icon_image != blank %}
              {{ block.settings.icon_image | image_url: width: 80 | image_tag: class: 'jk-process__icon-image', loading: 'lazy' }}
            {% else %}
              <span>{{ block.settings.icon }}</span>
            {% endif %}
          </div>
          <div class="jk-process__content">
            <p class="jk-process__label">{{ block.settings.step_label | default: 'Step' | escape }}</p>
            <div class="jk-process__title-row">
              {% if block.settings.title != blank %}
                <h3 class="jk-process__title">{{ block.settings.title | escape }}</h3>
              {% endif %}
              {% if block.settings.time != blank %}
                <span class="jk-process__time">
                  <svg viewBox="0 0 24 24" fill="none" aria-hidden="true"><circle cx="12" cy="12" r="9" stroke="currentColor" stroke-width="1.8"/><path d="M12 7v5l3 2" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"/></svg>
                  {{ block.settings.time | escape }}
                </span>
              {% endif %}
            </div>
            {% if block.settings.description != blank %}
              <p class="jk-process__description">{{ block.settings.description | escape }}</p>
            {% endif %}
          </div>
        </article>
      {% endfor %}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "JK Product process",
  "tag": "section",
  "class": "section",
  "enabled_on": {
    "templates": ["product"]
  },
  "max_blocks": 6,
  "settings": [
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "Color scheme",
      "default": "scheme-1"
    },
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Small heading",
      "default": "The process"
    },
    {
      "type": "inline_richtext",
      "id": "heading",
      "label": "Heading",
      "default": "Four steps. Ten minutes. Forever."
    },
    {
      "type": "text",
      "id": "subheading",
      "label": "Subheading",
      "default": "No pottery skills. No special tools. Just you and your baby."
    },
    {
      "type": "header",
      "content": "Spacing"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "label": "Top padding",
      "default": 64
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "label": "Bottom padding",
      "default": 64
    }
  ],
  "blocks": [
    {
      "type": "step",
      "name": "Process step",
      "settings": [
        {
          "type": "image_picker",
          "id": "icon_image",
          "label": "Custom icon image"
        },
        {
          "type": "text",
          "id": "icon",
          "label": "Emoji icon",
          "info": "Used when no custom icon image is selected.",
          "default": "✨"
        },
        {
          "type": "text",
          "id": "step_label",
          "label": "Step label",
          "default": "Step one"
        },
        {
          "type": "text",
          "id": "title",
          "label": "Title",
          "default": "Shape the clay"
        },
        {
          "type": "text",
          "id": "time",
          "label": "Duration",
          "default": "2 minutes"
        },
        {
          "type": "textarea",
          "id": "description",
          "label": "Description",
          "default": "Knead the clay until soft, then press it flat and shape a clean disc."
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "JK Product process",
      "blocks": [
        { "type": "step", "settings": { "icon": "🟫", "step_label": "Step one", "title": "Shape the clay", "time": "2 minutes", "description": "Knead the clay until soft, then press it flat and shape a clean disc." } },
        { "type": "step", "settings": { "icon": "🐾", "step_label": "Step two", "title": "Press the print", "time": "1 minute", "description": "Gently press your baby's foot or hand into the clay. Re-mould and try again if needed." } },
        { "type": "step", "settings": { "icon": "🌙", "step_label": "Step three", "title": "Let it dry", "time": "24–48 hours", "description": "Leave it somewhere flat and dry. No oven or kiln needed—it hardens naturally." } },
        { "type": "step", "settings": { "icon": "✨", "step_label": "Step four", "title": "Paint and display", "time": "Your moment", "description": "Add the finishing touches, attach the ribbon and display your forever memory." } }
      ]
    }
  ]
}
{% endschema %}
