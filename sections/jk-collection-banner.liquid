{% comment %}
  VLORA — Single Collection Banner
  Desktop: Slim centered banner
  Mobile: App-style compact collection card
{% endcomment %}

{% liquid
  assign section_id = 'vlora-collection-banner-' | append: section.id
%}

<section
  id="{{ section_id }}"
  class="vlora-collection-banner"
  aria-labelledby="{{ section_id }}-heading"
  style="
    --vcb-bg: {{ section.settings.background_color }};
    --vcb-text: {{ section.settings.text_color }};
    --vcb-muted: {{ section.settings.subtext_color }};
    --vcb-button-bg: {{ section.settings.button_background }};
    --vcb-button-text: {{ section.settings.button_text_color }};
    --vcb-accent: {{ section.settings.accent_color }};
  "
>
  <div class="vlora-collection-banner__inner page-width{% if section.settings.full_width %} vlora-collection-banner__inner--full-width{% endif %}">

    <div class="vlora-collection-banner__box">

      {% if section.settings.show_leaf %}
        <div
          class="vlora-collection-banner__leaf"
          aria-hidden="true"
        >
          <svg viewBox="0 0 90 90" fill="none">
            <path
              d="M16 70C29 44 43 27 72 15"
              stroke="currentColor"
              stroke-width="1.3"
              stroke-linecap="round"
            />

            <path
              d="M34 45C27 38 25 30 28 22C37 25 42 32 41 41"
              stroke="currentColor"
              stroke-width="1.2"
            />

            <path
              d="M46 34C43 25 46 17 53 11C59 19 58 27 52 34"
              stroke="currentColor"
              stroke-width="1.2"
            />

            <path
              d="M25 58C18 53 15 46 16 39C25 40 31 46 32 53"
              stroke="currentColor"
              stroke-width="1.2"
            />
          </svg>
        </div>
      {% endif %}

      <div class="vlora-collection-banner__content">

        {% if section.settings.eyebrow != blank %}
          <p class="vlora-collection-banner__eyebrow">
            {{ section.settings.eyebrow }}
          </p>
        {% endif %}

        {% if section.settings.heading != blank %}
          <{{ section.settings.heading_tag }}
            id="{{ section_id }}-heading"
            class="vlora-collection-banner__heading"
          >
            {{ section.settings.heading }}
          </{{ section.settings.heading_tag }}>
        {% endif %}

        {% if section.settings.description != blank %}
          <div class="vlora-collection-banner__description">
            {{ section.settings.description }}
          </div>
        {% endif %}

        {% if section.settings.button_text != blank %}
          <a
            href="{{ section.settings.button_link | default: routes.all_products_collection_url }}"
            class="vlora-collection-banner__button"
          >
            <span>{{ section.settings.button_text }}</span>

            {% if section.settings.show_arrow %}
              <svg
                viewBox="0 0 18 18"
                fill="none"
                aria-hidden="true"
              >
                <path
                  d="M3 9h11M10 5l4 4-4 4"
                  stroke="currentColor"
                  stroke-width="1.5"
                  stroke-linecap="round"
                  stroke-linejoin="round"
                />
              </svg>
            {% endif %}
          </a>
        {% endif %}

      </div>

      {% if section.settings.show_script %}
        <div
          class="vlora-collection-banner__script"
          aria-hidden="true"
        >
          {{ section.settings.script_text }}
          <span>♡</span>
        </div>
      {% endif %}

    </div>

  </div>
</section>

<style>
  #{{ section_id }} {
    width: 100%;
    background: {{ section.settings.section_background }};
  }

  #{{ section_id }} * {
    box-sizing: border-box;
  }

  #{{ section_id }} .vlora-collection-banner__inner {
    max-width: 1440px;
    margin: 0 auto;
    padding:
      {{ section.settings.desktop_spacing_top }}px
      20px
      {{ section.settings.desktop_spacing_bottom }}px;
  }

  #{{ section_id }} .vlora-collection-banner__inner--full-width {
    max-width: none;
    padding-left: 0;
    padding-right: 0;
  }

  #{{ section_id }} .vlora-collection-banner__inner--full-width .vlora-collection-banner__box {
    border-radius: 0;
  }

  #{{ section_id }} .vlora-collection-banner__box {
    min-height: {{ section.settings.desktop_height }}px;

    position: relative;
    overflow: hidden;

    display: flex;
    align-items: center;
    justify-content: center;

    padding: 22px 150px;

    background:
      linear-gradient(
        90deg,
        rgba(255,255,255,.18),
        rgba(255,255,255,0) 25%,
        rgba(255,255,255,0) 75%,
        rgba(255,255,255,.18)
      ),
      var(--vcb-bg);

    border-radius: {{ section.settings.border_radius }}px;
  }

  /*
    CENTER CONTENT
  */

  #{{ section_id }} .vlora-collection-banner__content {
    position: relative;
    z-index: 2;

    width: 100%;
    max-width: 800px;

    display: flex;
    flex-direction: column;
    align-items: center;

    text-align: center;
  }

  #{{ section_id }} .vlora-collection-banner__eyebrow {
    margin: 0 0 5px;

    color: var(--vcb-accent);

    font-size: 11px;
    font-weight: 600;
    line-height: 1.2;

    letter-spacing: .12em;
    text-transform: uppercase;
  }

  #{{ section_id }} .vlora-collection-banner__heading {
    margin: 0;

    color: var(--vcb-text);

    font-family: var(--font-heading-family);
    font-size: {{ section.settings.desktop_heading_size }}px;
    font-weight: 500;
    line-height: 1.05;

    letter-spacing: -.02em;
  }

  #{{ section_id }} .vlora-collection-banner__description {
    max-width: 680px;

    margin-top: 7px;

    color: var(--vcb-muted);

    font-size: {{ section.settings.desktop_text_size }}px;
    font-weight: 400;
    line-height: 1.45;
  }

  #{{ section_id }} .vlora-collection-banner__description p {
    margin: 0;
  }

  /*
    CTA
  */

  #{{ section_id }} .vlora-collection-banner__button {
    min-height: 39px;

    margin-top: 13px;
    padding: 0 21px;

    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 7px;

    background: var(--vcb-button-bg);
    color: var(--vcb-button-text);

    border: 1px solid var(--vcb-button-bg);
    border-radius: 999px;

    text-decoration: none;

    font-size: 12px;
    font-weight: 600;
    line-height: 1;

    transition:
      transform .2s ease,
      opacity .2s ease,
      box-shadow .2s ease;
  }

  #{{ section_id }} .vlora-collection-banner__button svg {
    width: 15px;
    height: 15px;
    flex: 0 0 15px;

    transition: transform .2s ease;
  }

  #{{ section_id }} .vlora-collection-banner__button:hover {
    transform: translateY(-1px);
    box-shadow: 0 5px 15px rgba(0,0,0,.08);
  }

  #{{ section_id }} .vlora-collection-banner__button:hover svg {
    transform: translateX(2px);
  }

  /*
    LEFT DECORATION
  */

  #{{ section_id }} .vlora-collection-banner__leaf {
    position: absolute;

    left: 25px;
    bottom: -7px;

    width: 90px;
    height: 90px;

    color: var(--vcb-accent);
    opacity: .16;

    pointer-events: none;
  }

  #{{ section_id }} .vlora-collection-banner__leaf svg {
    display: block;
    width: 100%;
    height: 100%;
  }

  /*
    RIGHT HANDWRITTEN TEXT
  */

  #{{ section_id }} .vlora-collection-banner__script {
    position: absolute;

    right: 45px;
    top: 50%;
    transform: translateY(-50%) rotate(-7deg);

    width: 105px;

    color: var(--vcb-text);
    opacity: .72;

    font-family: cursive;
    font-size: 18px;
    font-weight: 400;
    line-height: .95;

    text-align: center;

    pointer-events: none;
  }

  #{{ section_id }} .vlora-collection-banner__script span {
    display: block;
    margin-top: 2px;
    font-size: 17px;
  }

  /*
    TABLET
  */

  @media screen and (max-width: 990px) {
    #{{ section_id }} .vlora-collection-banner__box {
      padding-left: 110px;
      padding-right: 110px;
    }

    #{{ section_id }} .vlora-collection-banner__script {
      right: 20px;
      width: 85px;
      font-size: 15px;
    }

    #{{ section_id }} .vlora-collection-banner__leaf {
      left: 10px;
      width: 75px;
      height: 75px;
    }
  }

  /*
    MOBILE — APP STYLE
  */

  @media screen and (max-width: 749px) {

    #{{ section_id }} .vlora-collection-banner__inner {
      padding:
        {{ section.settings.mobile_spacing_top }}px
        12px
        {{ section.settings.mobile_spacing_bottom }}px;
    }

    #{{ section_id }} .vlora-collection-banner__inner--full-width {
      padding-left: 0;
      padding-right: 0;
    }

    #{{ section_id }} .vlora-collection-banner__box {
      min-height: {{ section.settings.mobile_height }}px;

      padding: 20px 16px;

      border-radius: {{ section.settings.mobile_border_radius }}px;
    }

    #{{ section_id }} .vlora-collection-banner__content {
      max-width: 100%;
    }

    #{{ section_id }} .vlora-collection-banner__eyebrow {
      margin-bottom: 4px;
      font-size: 9px;
    }

    #{{ section_id }} .vlora-collection-banner__heading {
      font-size: {{ section.settings.mobile_heading_size }}px;
      line-height: 1.08;
    }

    #{{ section_id }} .vlora-collection-banner__description {
      max-width: 310px;

      margin-top: 6px;

      font-size: {{ section.settings.mobile_text_size }}px;
      line-height: 1.4;
    }

    #{{ section_id }} .vlora-collection-banner__button {
      min-height: 40px;

      margin-top: 12px;
      padding: 0 20px;

      font-size: 12px;
    }

    /*
      Keep decoration subtle on mobile
    */

    #{{ section_id }} .vlora-collection-banner__leaf {
      left: -12px;
      bottom: -12px;

      width: 76px;
      height: 76px;

      opacity: .1;
    }

    #{{ section_id }} .vlora-collection-banner__script {
      right: 5px;
      top: 13px;

      transform: rotate(-7deg);

      width: 62px;

      font-size: 11px;
      line-height: .95;

      opacity: .45;
    }

    #{{ section_id }} .vlora-collection-banner__script span {
      font-size: 12px;
    }
  }

  /*
    VERY SMALL MOBILE
  */

  @media screen and (max-width: 374px) {
    #{{ section_id }} .vlora-collection-banner__script {
      display: none;
    }

    #{{ section_id }} .vlora-collection-banner__box {
      padding-left: 13px;
      padding-right: 13px;
    }
  }
</style>

{% schema %}
{
  "name": "Jk Collection Banner",
  "tag": "section",
  "class": "section-vlora-collection-banner",

  "settings": [
    {
      "type": "header",
      "content": "Content"
    },
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Baby Keepsakes Collection"
    },
    {
      "type": "select",
      "id": "heading_tag",
      "label": "Heading HTML tag",
      "default": "h2",
      "options": [
        {
          "value": "h2",
          "label": "H2"
        },
        {
          "value": "h3",
          "label": "H3"
        },
        {
          "value": "p",
          "label": "Paragraph"
        }
      ]
    },
    {
      "type": "richtext",
      "id": "description",
      "label": "Description",
      "default": "<p>Thoughtfully designed keepsakes to capture every little milestone — because these moments only happen once.</p>"
    },
    {
      "type": "text",
      "id": "button_text",
      "label": "Button text",
      "default": "Shop the Collection"
    },
    {
      "type": "url",
      "id": "button_link",
      "label": "Collection link"
    },
    {
      "type": "checkbox",
      "id": "show_arrow",
      "label": "Show button arrow",
      "default": true
    },

    {
      "type": "header",
      "content": "Decorations"
    },
    {
      "type": "checkbox",
      "id": "show_leaf",
      "label": "Show leaf decoration",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "show_script",
      "label": "Show handwritten text",
      "default": true
    },
    {
      "type": "text",
      "id": "script_text",
      "label": "Handwritten text",
      "default": "Cherish Forever"
    },

    {
      "type": "header",
      "content": "Colors"
    },
    {
      "type": "color",
      "id": "section_background",
      "label": "Outside background",
      "default": "#FFFFFF"
    },
    {
      "type": "color",
      "id": "background_color",
      "label": "Banner background",
      "default": "#FAF1EB"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Heading color",
      "default": "#252525"
    },
    {
      "type": "color",
      "id": "subtext_color",
      "label": "Description color",
      "default": "#55514F"
    },
    {
      "type": "color",
      "id": "accent_color",
      "label": "Accent color",
      "default": "#CBAFA4"
    },
    {
      "type": "color",
      "id": "button_background",
      "label": "Button background",
      "default": "#D85E67"
    },
    {
      "type": "color",
      "id": "button_text_color",
      "label": "Button text",
      "default": "#FFFFFF"
    },

    {
      "type": "header",
      "content": "Desktop layout"
    },
    {
      "type": "checkbox",
      "id": "full_width",
      "label": "Use full-width banner",
      "info": "Remove the page-width limit and stretch the banner to the viewport edges.",
      "default": false
    },
    {
      "type": "range",
      "id": "desktop_height",
      "min": 100,
      "max": 260,
      "step": 10,
      "unit": "px",
      "label": "Banner minimum height",
      "default": 160
    },
    {
      "type": "range",
      "id": "desktop_heading_size",
      "min": 20,
      "max": 42,
      "step": 1,
      "unit": "px",
      "label": "Heading size",
      "default": 27
    },
    {
      "type": "range",
      "id": "desktop_text_size",
      "min": 10,
      "max": 18,
      "step": 1,
      "unit": "px",
      "label": "Description size",
      "default": 12
    },
    {
      "type": "range",
      "id": "border_radius",
      "min": 0,
      "max": 30,
      "step": 2,
      "unit": "px",
      "label": "Border radius",
      "default": 0
    },
    {
      "type": "range",
      "id": "desktop_spacing_top",
      "min": 0,
      "max": 50,
      "step": 2,
      "unit": "px",
      "label": "Top spacing",
      "default": 0
    },
    {
      "type": "range",
      "id": "desktop_spacing_bottom",
      "min": 0,
      "max": 50,
      "step": 2,
      "unit": "px",
      "label": "Bottom spacing",
      "default": 0
    },

    {
      "type": "header",
      "content": "Mobile layout"
    },
    {
      "type": "range",
      "id": "mobile_height",
      "min": 120,
      "max": 240,
      "step": 10,
      "unit": "px",
      "label": "Minimum height",
      "default": 170
    },
    {
      "type": "range",
      "id": "mobile_heading_size",
      "min": 20,
      "max": 32,
      "step": 1,
      "unit": "px",
      "label": "Heading size",
      "default": 25
    },
    {
      "type": "range",
      "id": "mobile_text_size",
      "min": 10,
      "max": 16,
      "step": 1,
      "unit": "px",
      "label": "Description size",
      "default": 12
    },
    {
      "type": "range",
      "id": "mobile_border_radius",
      "min": 0,
      "max": 30,
      "step": 2,
      "unit": "px",
      "label": "Card radius",
      "default": 14
    },
    {
      "type": "range",
      "id": "mobile_spacing_top",
      "min": 0,
      "max": 40,
      "step": 2,
      "unit": "px",
      "label": "Top spacing",
      "default": 10
    },
    {
      "type": "range",
      "id": "mobile_spacing_bottom",
      "min": 0,
      "max": 40,
      "step": 2,
      "unit": "px",
      "label": "Bottom spacing",
      "default": 10
    }
  ],

  "presets": [
    {
      "name": "Jk Collection Banner"
    }
  ]
}
{% endschema %}
