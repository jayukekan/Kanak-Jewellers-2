{% comment %}
  VLORA — Parent testimonials
  Editable review cards with responsive swipe rail on mobile.
{% endcomment %}

{% liquid
  assign section_id = 'vlora-testimonials-' | append: section.id
%}

<section
  id="{{ section_id }}"
  class="vlora-testimonials"
  aria-labelledby="{{ section_id }}-heading"
  style="
    --vt-bg: {{ section.settings.background_color }};
    --vt-card: {{ section.settings.card_background }};
    --vt-border: {{ section.settings.card_border }};
    --vt-text: {{ section.settings.text_color }};
    --vt-muted: {{ section.settings.muted_color }};
    --vt-stars: {{ section.settings.star_color }};
    --vt-badge: {{ section.settings.badge_color }};
  "
>
  <div class="vlora-testimonials__inner page-width">
    {% if section.settings.heading != blank %}
      <h2 id="{{ section_id }}-heading" class="vlora-testimonials__heading">{{ section.settings.heading }}</h2>
    {% endif %}
    {% if section.settings.subheading != blank %}
      <div class="vlora-testimonials__subheading rte">{{ section.settings.subheading }}</div>
    {% endif %}

    <div class="vlora-testimonials__track" role="list">
      {% for block in section.blocks %}
        <article class="vlora-testimonials__card" role="listitem" {{ block.shopify_attributes }}>
          <div class="vlora-testimonials__profile">
            <div class="vlora-testimonials__avatar">
              {% if block.settings.photo != blank %}
                {{
                  block.settings.photo
                  | image_url: width: 180
                  | image_tag:
                    loading: 'lazy',
                    widths: '72, 108, 144, 180',
                    sizes: '72px',
                    class: 'vlora-testimonials__avatar-image',
                    alt: block.settings.name
                }}
              {% else %}
                {{ 'image' | placeholder_svg_tag: 'vlora-testimonials__avatar-placeholder placeholder-svg' }}
              {% endif %}
            </div>

            <div class="vlora-testimonials__identity">
              {% if block.settings.name != blank %}
                <h3 class="vlora-testimonials__name">{{ block.settings.name | escape }}</h3>
              {% endif %}
              {% if block.settings.location != blank %}
                <p class="vlora-testimonials__location">{{ block.settings.location | escape }}</p>
              {% endif %}
            </div>
          </div>

          <div class="vlora-testimonials__review">
            <div class="vlora-testimonials__meta">
              <span class="vlora-testimonials__stars" aria-label="{{ block.settings.rating }} out of 5 stars">
                {% for star in (1..5) %}
                  <span class="vlora-testimonials__star{% if star > block.settings.rating %} vlora-testimonials__star--empty{% endif %}" aria-hidden="true">★</span>
                {% endfor %}
              </span>
              {% if block.settings.verified %}
                <span class="vlora-testimonials__verified">
                  <span class="vlora-testimonials__verified-icon" aria-hidden="true">✓</span>
                  {{ section.settings.verified_label | escape }}
                </span>
              {% endif %}
            </div>

            {% if block.settings.review != blank %}
              <div class="vlora-testimonials__text rte">{{ block.settings.review }}</div>
            {% endif %}
          </div>
        </article>
      {% endfor %}
    </div>
  </div>
</section>

<style>
  #{{ section_id }} {
    width: 100%;
    background: var(--vt-bg);
    color: var(--vt-text);
  }

  #{{ section_id }} * { box-sizing: border-box; }

  #{{ section_id }} .vlora-testimonials__inner {
    max-width: 1440px;
    padding-top: {{ section.settings.padding_top }}px;
    padding-bottom: {{ section.settings.padding_bottom }}px;
  }

  #{{ section_id }} .vlora-testimonials__heading {
    margin: 0;
    color: var(--vt-text);
    font-family: var(--font-heading-family);
    font-size: {{ section.settings.heading_size }}px;
    padding-bottom: 20px;
    font-weight: 600;
    line-height: 1.15;
    text-align: center;
  }

  #{{ section_id }} .vlora-testimonials__subheading {
    max-width: 600px;
    margin: 8px auto 24px;
    color: var(--vt-muted);
    font-size: 13px;
    text-align: center;
  }

  #{{ section_id }} .vlora-testimonials__subheading p { margin: 0; }

  #{{ section_id }} .vlora-testimonials__track {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: {{ section.settings.card_gap }}px;
  }

  #{{ section_id }} .vlora-testimonials__card {
    display: grid;
    grid-template-columns: minmax(72px, 26%) 1fr;
    min-width: 0;
    min-height: {{ section.settings.card_min_height }}px;
    overflow: hidden;
    border: 1px solid var(--vt-border);
    border-radius: {{ section.settings.card_radius }}px;
    background: var(--vt-card);
    box-shadow: 0 3px 16px rgba(56, 39, 31, 0.04);
  }

  #{{ section_id }} .vlora-testimonials__profile {
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 8px;
    padding: 18px 10px;
    border-right: 1px solid var(--vt-border);
    text-align: center;
  }

  #{{ section_id }} .vlora-testimonials__avatar {
    width: {{ section.settings.avatar_size }}px;
    height: {{ section.settings.avatar_size }}px;
    overflow: hidden;
    border: 2px solid #fff;
    border-radius: 50%;
    background: #eee5df;
    box-shadow: 0 2px 7px rgba(45, 30, 24, 0.12);
  }

  #{{ section_id }} .vlora-testimonials__avatar-image,
  #{{ section_id }} .vlora-testimonials__avatar-placeholder {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  #{{ section_id }} .vlora-testimonials__name {
    margin: 0;
    color: var(--vt-text);
    font-family: var(--font-body-family);
    font-size: 12px;
    font-weight: 700;
    line-height: 1.15;
  }

  #{{ section_id }} .vlora-testimonials__location {
    margin: 3px 0 0;
    color: var(--vt-muted);
    font-size: 10px;
    line-height: 1.2;
  }

  #{{ section_id }} .vlora-testimonials__review {
    display: flex;
    flex-direction: column;
    justify-content: center;
    min-width: 0;
    padding: 18px 16px;
  }

  #{{ section_id }} .vlora-testimonials__meta {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 7px;
  }

  #{{ section_id }} .vlora-testimonials__stars {
    display: inline-flex;
    gap: 1px;
    color: var(--vt-stars);
    font-size: 14px;
    letter-spacing: 0.04em;
    line-height: 1;
  }

  #{{ section_id }} .vlora-testimonials__star--empty { color: #dfd6d1; }

  #{{ section_id }} .vlora-testimonials__verified {
    display: inline-flex;
    align-items: center;
    gap: 3px;
    color: var(--vt-muted);
    font-size: 9px;
    font-weight: 600;
    white-space: nowrap;
  }

  #{{ section_id }} .vlora-testimonials__verified-icon {
    display: inline-grid;
    width: 14px;
    height: 14px;
    place-items: center;
    border-radius: 50%;
    background: var(--vt-badge);
    color: #fff;
    font-size: 9px;
  }

  #{{ section_id }} .vlora-testimonials__text {
    margin-top: 8px;
    color: var(--vt-muted);
    font-size: {{ section.settings.text_size }}px;
    line-height: 1.42;
  }

  #{{ section_id }} .vlora-testimonials__text p { margin: 0; }

  @media screen and (max-width: 989px) {
    #{{ section_id }} .vlora-testimonials__track { grid-template-columns: repeat(2, minmax(0, 1fr)); }
  }

  @media screen and (max-width: 749px) {
    #{{ section_id }} .vlora-testimonials__inner {
      padding-top: {{ section.settings.mobile_padding_top }}px;
      padding-bottom: {{ section.settings.mobile_padding_bottom }}px;
    }

    #{{ section_id }} .vlora-testimonials__heading { font-size: {{ section.settings.mobile_heading_size }}px; }
    #{{ section_id }} .vlora-testimonials__subheading { margin-bottom: 18px; font-size: 12px; }
    #{{ section_id }} .vlora-testimonials__track {
      display: flex;
      gap: 12px;
      margin-right: -1.5rem;
      padding-right: 1.5rem;
      overflow-x: auto;
      scroll-snap-type: x mandatory;
      scrollbar-width: none;
    }

    #{{ section_id }} .vlora-testimonials__track::-webkit-scrollbar { display: none; }
    #{{ section_id }} .vlora-testimonials__card {
      flex: 0 0 min(87vw, 360px);
      scroll-snap-align: start;
    }
  }
</style>

{% schema %}
{
  "name": "VLORA Parent testimonials",
  "tag": "section",
  "class": "section",
  "disabled_on": { "groups": ["header", "footer"] },
  "settings": [
    { "type": "text", "id": "heading", "label": "Heading", "default": "Parents Are Loving Vlora" },
    { "type": "richtext", "id": "subheading", "label": "Subheading" },
    { "type": "text", "id": "verified_label", "label": "Verified label", "default": "Verified purchase" },
    { "type": "range", "id": "heading_size", "min": 22, "max": 48, "step": 1, "unit": "px", "label": "Desktop heading size", "default": 30 },
    { "type": "range", "id": "mobile_heading_size", "min": 20, "max": 34, "step": 1, "unit": "px", "label": "Mobile heading size", "default": 25 },
    { "type": "range", "id": "text_size", "min": 11, "max": 18, "step": 1, "unit": "px", "label": "Review text size", "default": 12 },
    { "type": "range", "id": "avatar_size", "min": 48, "max": 96, "step": 4, "unit": "px", "label": "Avatar size", "default": 64 },
    { "type": "range", "id": "card_min_height", "min": 140, "max": 300, "step": 10, "unit": "px", "label": "Card minimum height", "default": 150 },
    { "type": "range", "id": "card_gap", "min": 8, "max": 36, "step": 2, "unit": "px", "label": "Card gap", "default": 16 },
    { "type": "range", "id": "card_radius", "min": 0, "max": 28, "step": 2, "unit": "px", "label": "Card corner radius", "default": 12 },
    { "type": "color", "id": "background_color", "label": "Section background", "default": "#fffaf6" },
    { "type": "color", "id": "card_background", "label": "Card background", "default": "#fffdfb" },
    { "type": "color", "id": "card_border", "label": "Card border", "default": "#eee5df" },
    { "type": "color", "id": "text_color", "label": "Text", "default": "#241d1a" },
    { "type": "color", "id": "muted_color", "label": "Review text", "default": "#5d5652" },
    { "type": "color", "id": "star_color", "label": "Star color", "default": "#e9a91b" },
    { "type": "color", "id": "badge_color", "label": "Verified badge", "default": "#bf7779" },
    { "type": "range", "id": "padding_top", "min": 0, "max": 100, "step": 4, "unit": "px", "label": "Desktop top padding", "default": 48 },
    { "type": "range", "id": "padding_bottom", "min": 0, "max": 100, "step": 4, "unit": "px", "label": "Desktop bottom padding", "default": 48 },
    { "type": "range", "id": "mobile_padding_top", "min": 0, "max": 80, "step": 4, "unit": "px", "label": "Mobile top padding", "default": 36 },
    { "type": "range", "id": "mobile_padding_bottom", "min": 0, "max": 80, "step": 4, "unit": "px", "label": "Mobile bottom padding", "default": 36 }
  ],
  "blocks": [
    {
      "type": "testimonial",
      "name": "Testimonial",
      "settings": [
        { "type": "image_picker", "id": "photo", "label": "Parent photo" },
        { "type": "text", "id": "name", "label": "Name", "default": "Priya S." },
        { "type": "text", "id": "location", "label": "Location", "default": "Mumbai, India" },
        { "type": "range", "id": "rating", "min": 1, "max": 5, "step": 1, "label": "Star rating", "default": 5 },
        { "type": "checkbox", "id": "verified", "label": "Show verified badge", "default": true },
        { "type": "richtext", "id": "review", "label": "Review", "default": "<p>Beautiful and easy to use! Our little one's tiny toes are captured perfectly.</p>" }
      ]
    }
  ],
  "max_blocks": 6,
  "presets": [
    {
      "name": "VLORA Parent testimonials",
      "blocks": [
        { "type": "testimonial", "settings": { "name": "Priya S.", "location": "Mumbai, India", "review": "<p>Beautiful and easy to use! Our little one's tiny toes are captured perfectly.</p>" } },
        { "type": "testimonial", "settings": { "name": "Rahul M.", "location": "Bengaluru, India", "review": "<p>Creating quality and a treasured keepsake. Our little one loves looking at it.</p>" } },
        { "type": "testimonial", "settings": { "name": "Neha T.", "location": "Pune, India", "review": "<p>One of our new parents' most meaningful experiences. Such a lovely memory.</p>" } }
      ]
    }
  ]
}
{% endschema %}
