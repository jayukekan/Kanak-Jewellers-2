{{ 'jayesh-kekan.css' | asset_url | stylesheet_tag }}

{%- liquid
  assign left_product = section.settings.left_product | default: collections.all.products[0]
  assign right_product = section.settings.right_product | default: collections.all.products[1] | default: collections.all.products[0]
  assign left_image = section.settings.left_image | default: left_product.featured_image
  assign right_image = section.settings.right_image | default: right_product.featured_image
  assign left_link = section.settings.button_link | default: left_product.url | default: routes.all_products_collection_url
  assign right_link = section.settings.right_link | default: right_product.url | default: routes.all_products_collection_url
  assign right_title = section.settings.right_title | default: right_product.title | default: 'Earrings Lolita'

  case section.settings.image_ratio
    when 'portrait'
      assign panel_ratio = 0.8
    when 'landscape'
      assign panel_ratio = 1.33
    when 'adapt'
      assign panel_ratio = left_image.aspect_ratio | default: 1
    else
      assign panel_ratio = 1
  endcase
-%}

<section
  class="xc-dual-editorial xc-dual-editorial--heading-{{ section.settings.heading_size }} color-{{ section.settings.color_scheme }} gradient"
  style="--xc-padding-top: {{ section.settings.padding_top }}px; --xc-padding-bottom: {{ section.settings.padding_bottom }}px; --xc-panel-gap: {{ section.settings.panel_gap }}px; --xc-panel-ratio: {{ panel_ratio }}; --xc-overlay-text: {{ section.settings.left_text_color }}; --xc-overlay-opacity: {{ section.settings.left_overlay_opacity | divided_by: 100.0 }}; --xc-button-background: {{ section.settings.button_background }}; --xc-button-text: {{ section.settings.button_text_color }}; --xc-button-radius: {{ section.settings.button_radius }}px; --xc-product-text: {{ section.settings.right_text_color }};"
>
  <div class="xc-dual-editorial__grid{% unless section.settings.full_width %} page-width{% endunless %}">
    <div class="xc-dual-editorial__panel xc-dual-editorial__panel--campaign">
      {%- if left_image != blank -%}
        {{ left_image | image_url: width: 1800 | image_tag: class: 'xc-dual-editorial__image', loading: 'lazy', widths: '400, 600, 800, 1000, 1200, 1500, 1800', sizes: '(min-width: 750px) 50vw, 100vw' }}
      {%- else -%}
        <div class="xc-dual-editorial__placeholder">{{ 'lifestyle-1' | placeholder_svg_tag }}</div>
      {%- endif -%}

      <div class="xc-dual-editorial__content xc-dual-editorial__content--{{ section.settings.content_vertical }} xc-dual-editorial__content--{{ section.settings.content_alignment }}">
        <h2 class="xc-dual-editorial__heading">
          <span>{{ section.settings.heading_line_1 | escape }}</span>
          <span>{{ section.settings.heading_line_2 | escape }}</span>
        </h2>
        {%- if section.settings.button_label != blank -%}<a class="xc-dual-editorial__button" href="{{ left_link }}">{{ section.settings.button_label | escape }}</a>{%- endif -%}
      </div>
    </div>

    <div class="xc-dual-editorial__panel xc-dual-editorial__panel--product">
      {%- if right_image != blank -%}
        {{ right_image | image_url: width: 1800 | image_tag: class: 'xc-dual-editorial__image', loading: 'lazy', widths: '400, 600, 800, 1000, 1200, 1500, 1800', sizes: '(min-width: 750px) 50vw, 100vw' }}
      {%- else -%}
        <div class="xc-dual-editorial__placeholder">{{ 'product-apparel-1' | placeholder_svg_tag }}</div>
      {%- endif -%}
      <a class="xc-dual-editorial__product-link" href="{{ right_link }}" aria-label="{{ right_title | escape }}"></a>
      <div class="xc-dual-editorial__product-meta">
        {%- if section.settings.show_product_title -%}<p class="xc-dual-editorial__product-title">{{ right_title | escape }}</p>{%- endif -%}
        {%- if section.settings.show_product_price -%}
          <p class="xc-dual-editorial__product-price">
            {%- if section.settings.custom_price != blank -%}{{ section.settings.custom_price | escape }}{%- elsif right_product != blank -%}{{ right_product.price | money }}{%- endif -%}
          </p>
        {%- endif -%}
      </div>
    </div>
  </div>
</section>

{% schema %}
{
  "name": "jk dual editorial",
  "tag": "section",
  "class": "section-xc-dual-editorial",
  "settings": [
    { "type": "header", "content": "Layout" },
    { "type": "checkbox", "id": "full_width", "label": "Make section full width", "default": true },
    {
      "type": "select",
      "id": "image_ratio",
      "label": "Image ratio",
      "options": [
        { "value": "adapt", "label": "Adapt to first image" },
        { "value": "portrait", "label": "Portrait" },
        { "value": "square", "label": "Square" },
        { "value": "landscape", "label": "Landscape" }
      ],
      "default": "square"
    },
    { "type": "range", "id": "panel_gap", "min": 0, "max": 40, "step": 2, "unit": "px", "label": "Gap between images", "default": 0 },
    { "type": "color_scheme", "id": "color_scheme", "label": "Section color scheme", "default": "scheme-1" },
    { "type": "header", "content": "Left campaign" },
    { "type": "product", "id": "left_product", "label": "Fallback product" },
    { "type": "image_picker", "id": "left_image", "label": "Image" },
    { "type": "text", "id": "heading_line_1", "label": "Heading line 1", "default": "Designed to Be Worn" },
    { "type": "text", "id": "heading_line_2", "label": "Heading line 2", "default": "Every Day" },
    {
      "type": "select",
      "id": "heading_size",
      "label": "Heading size",
      "options": [
        { "value": "small", "label": "Small" },
        { "value": "medium", "label": "Medium" },
        { "value": "large", "label": "Large" }
      ],
      "default": "medium"
    },
    {
      "type": "select",
      "id": "content_vertical",
      "label": "Vertical position",
      "options": [
        { "value": "top", "label": "Top" },
        { "value": "middle", "label": "Middle" },
        { "value": "bottom", "label": "Bottom" }
      ],
      "default": "middle"
    },
    {
      "type": "select",
      "id": "content_alignment",
      "label": "Content alignment",
      "options": [
        { "value": "left", "label": "Left" },
        { "value": "center", "label": "Center" },
        { "value": "right", "label": "Right" }
      ],
      "default": "center"
    },
    { "type": "range", "id": "left_overlay_opacity", "min": 0, "max": 70, "step": 5, "unit": "%", "label": "Image overlay", "default": 10 },
    { "type": "color", "id": "left_text_color", "label": "Text color", "default": "#ffffff" },
    { "type": "text", "id": "button_label", "label": "Button label", "default": "Discover New Arrivals" },
    { "type": "url", "id": "button_link", "label": "Button link" },
    { "type": "color", "id": "button_background", "label": "Button background", "default": "#ffffff" },
    { "type": "color", "id": "button_text_color", "label": "Button text", "default": "#111111" },
    { "type": "range", "id": "button_radius", "min": 0, "max": 40, "step": 2, "unit": "px", "label": "Button corner radius", "default": 24 },
    { "type": "header", "content": "Right product" },
    { "type": "product", "id": "right_product", "label": "Product" },
    { "type": "image_picker", "id": "right_image", "label": "Custom image" },
    { "type": "text", "id": "right_title", "label": "Custom product title" },
    { "type": "url", "id": "right_link", "label": "Custom link" },
    { "type": "checkbox", "id": "show_product_title", "label": "Show product title", "default": true },
    { "type": "checkbox", "id": "show_product_price", "label": "Show product price", "default": true },
    { "type": "text", "id": "custom_price", "label": "Custom price" },
    { "type": "color", "id": "right_text_color", "label": "Text color", "default": "#ffffff" },
    { "type": "header", "content": "Section spacing" },
    { "type": "range", "id": "padding_top", "min": 0, "max": 120, "step": 4, "unit": "px", "label": "Top padding", "default": 32 },
    { "type": "range", "id": "padding_bottom", "min": 0, "max": 120, "step": 4, "unit": "px", "label": "Bottom padding", "default": 32 }
  ],
  "presets": [{ "name": "jk dual editorial" }]
}
{% endschema %}
