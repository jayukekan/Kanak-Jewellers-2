        "custom_liquid_CFynxR": {
          "type": "custom_liquid",
          "settings": {
            "custom_liquid": "<div class=\"vlora-review-slider\" id=\"vlora-review-slider-{{ section.id | default: 'custom' }}\">\n  <div class=\"vlora-review-card\">\n\n    <button class=\"vlora-review-arrow vlora-review-prev\" type=\"button\" aria-label=\"Previous review\">\n      &#8249;\n    </button>\n\n    <div class=\"vlora-review-content\">\n\n      <div class=\"vlora-review-top\">\n        <div class=\"vlora-review-stars\">★★★★★</div>\n        <span class=\"vlora-review-badge\">CUSTOMER REVIEW</span>\n      </div>\n\n      <div class=\"vlora-review-slides\">\n\n        <div class=\"vlora-review-slide is-active\">\n          <p class=\"vlora-review-text\">\n            Absolutely loved this product! The quality feels really good and it was very easy to use.\n          </p>\n\n          <div class=\"vlora-review-author\">\n            <div class=\"vlora-review-avatar\">P</div>\n            <div>\n              <div class=\"vlora-review-name\">Priya Sharma</div>\n              <div class=\"vlora-review-meta\">Verified Customer</div>\n            </div>\n          </div>\n        </div>\n\n        <div class=\"vlora-review-slide\">\n          <p class=\"vlora-review-text\">\n            Really happy with my purchase. The product looks exactly as expected and the overall experience was great.\n          </p>\n\n          <div class=\"vlora-review-author\">\n            <div class=\"vlora-review-avatar\">N</div>\n            <div>\n              <div class=\"vlora-review-name\">Neha Verma</div>\n              <div class=\"vlora-review-meta\">Verified Customer</div>\n            </div>\n          </div>\n        </div>\n\n        <div class=\"vlora-review-slide\">\n          <p class=\"vlora-review-text\">\n            Very useful and nicely made. Packaging was neat and the product quality impressed me.\n          </p>\n\n          <div class=\"vlora-review-author\">\n            <div class=\"vlora-review-avatar\">R</div>\n            <div>\n              <div class=\"vlora-review-name\">Riya Mehta</div>\n              <div class=\"vlora-review-meta\">Verified Customer</div>\n            </div>\n          </div>\n        </div>\n\n      </div>\n    </div>\n\n    <button class=\"vlora-review-arrow vlora-review-next\" type=\"button\" aria-label=\"Next review\">\n      &#8250;\n    </button>\n\n  </div>\n</div>\n\n<style>\n.vlora-review-slider {\n  width: 100%;\n  margin: 18px 0;\n  font-family: inherit;\n}\n\n.vlora-review-card {\n  position: relative;\n  display: flex;\n  align-items: center;\n  gap: 14px;\n  background: #fcfdf8;\n  border: 1px solid #dce9c8;\n  border-radius: 22px;\n  padding: 22px 62px;\n  overflow: hidden;\n}\n\n.vlora-review-content {\n  width: 100%;\n}\n\n.vlora-review-top {\n  display: flex;\n  align-items: center;\n  justify-content: space-between;\n  gap: 12px;\n  margin-bottom: 10px;\n}\n\n.vlora-review-stars {\n  color: #ffad00;\n  font-size: 17px;\n  letter-spacing: 2px;\n  line-height: 1;\n}\n\n.vlora-review-badge {\n  background: #edf5dc;\n  color: #72992d;\n  font-size: 10px;\n  font-weight: 700;\n  padding: 6px 12px;\n  border-radius: 50px;\n  white-space: nowrap;\n}\n\n.vlora-review-slide {\n  display: none;\n}\n\n.vlora-review-slide.is-active {\n  display: block;\n  animation: vloraReviewFade .3s ease;\n}\n\n@keyframes vloraReviewFade {\n  from {\n    opacity: 0;\n    transform: translateY(3px);\n  }\n  to {\n    opacity: 1;\n    transform: translateY(0);\n  }\n}\n\n.vlora-review-text {\n  margin: 0 0 13px;\n  color: #404040;\n  font-size: 14px;\n  line-height: 1.55;\n  font-weight: 500;\n}\n\n.vlora-review-author {\n  display: flex;\n  align-items: center;\n  gap: 10px;\n}\n\n.vlora-review-avatar {\n  width: 32px;\n  height: 32px;\n  min-width: 32px;\n  border-radius: 50%;\n  background: #7bae24;\n  color: #fff;\n  display: flex;\n  align-items: center;\n  justify-content: center;\n  font-size: 13px;\n  font-weight: 700;\n}\n\n.vlora-review-name {\n  color: #5e8520;\n  font-size: 13px;\n  line-height: 1.2;\n  font-weight: 700;\n}\n\n.vlora-review-meta {\n  color: #9a9a9a;\n  font-size: 11px;\n  line-height: 1.3;\n  margin-top: 2px;\n}\n\n.vlora-review-arrow {\n  position: absolute;\n  top: 50%;\n  transform: translateY(-50%);\n  width: 36px;\n  height: 36px;\n  border-radius: 50%;\n  border: 1px solid #e1e7d7;\n  background: #fff;\n  color: #333;\n  font-size: 26px;\n  line-height: 1;\n  cursor: pointer;\n  z-index: 3;\n  display: flex;\n  align-items: center;\n  justify-content: center;\n  box-shadow: 0 5px 18px rgba(0,0,0,.06);\n}\n\n.vlora-review-prev {\n  left: 17px;\n}\n\n.vlora-review-next {\n  right: 17px;\n}\n\n.vlora-review-arrow:hover {\n  background: #f6f9ef;\n}\n\n@media screen and (max-width: 749px) {\n\n  .vlora-review-card {\n    border-radius: 18px;\n    padding: 18px 45px;\n  }\n\n  .vlora-review-arrow {\n    width: 30px;\n    height: 30px;\n    font-size: 22px;\n  }\n\n  .vlora-review-prev {\n    left: 8px;\n  }\n\n  .vlora-review-next {\n    right: 8px;\n  }\n\n  .vlora-review-text {\n    font-size: 13px;\n    line-height: 1.5;\n  }\n\n  .vlora-review-stars {\n    font-size: 14px;\n    letter-spacing: 1px;\n  }\n\n  .vlora-review-badge {\n    font-size: 8px;\n    padding: 5px 8px;\n  }\n\n  .vlora-review-name {\n    font-size: 12px;\n  }\n\n  .vlora-review-meta {\n    font-size: 10px;\n  }\n\n}\n</style>\n\n<script>\n(function() {\n  function initVloraReviewSlider() {\n\n    document.querySelectorAll('.vlora-review-slider').forEach(function(slider) {\n\n      if (slider.dataset.initialized === 'true') return;\n      slider.dataset.initialized = 'true';\n\n      const slides = slider.querySelectorAll('.vlora-review-slide');\n      const prev = slider.querySelector('.vlora-review-prev');\n      const next = slider.querySelector('.vlora-review-next');\n\n      if (!slides.length) return;\n\n      let current = 0;\n\n      function showSlide(index) {\n        slides.forEach(function(slide) {\n          slide.classList.remove('is-active');\n        });\n\n        slides[index].classList.add('is-active');\n      }\n\n      next.addEventListener('click', function() {\n        current = (current + 1) % slides.length;\n        showSlide(current);\n      });\n\n      prev.addEventListener('click', function() {\n        current = (current - 1 + slides.length) % slides.length;\n        showSlide(current);\n      });\n\n    });\n  }\n\n  document.addEventListener('DOMContentLoaded', initVloraReviewSlider);\n\n  if (document.readyState !== 'loading') {\n    initVloraReviewSlider();\n  }\n})();\n</script>"
